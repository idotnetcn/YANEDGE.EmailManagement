{
  "App": {
    "CorsOrigins": "http://localhost:4200,http://localhost:3000"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=EmailManagement;Username=postgres;Password=postgres"
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "EmailManagement:"
  },
  "Security": {
    "RateLimit": {
      "Enabled": true,
      "DefaultMaxRequests": 100,
      "DefaultWindowSeconds": 60
    },
    "SecurityHeaders": {
      "Enabled": true,
      "EnableHsts": true,
      "HstsMaxAge": 31536000,
      "EnableContentSecurityPolicy": true
    },
    "VirusScan": {
      "Enabled": true,
      "UseClamdScan": true,
      "ScanTimeoutSeconds": 300,
      "MaxFileSizeMB": 100
    }
  },
  "Elasticsearch": {
    "Enabled": false,
    "Url": "http://localhost:9200",
    "Username": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}


